# Maintainer: shakes76 <shakes76@gmail.com>
# Forked from omawrite by David Heinemeier Hansson <david@hey.com>

pkgname=omalorem
pkgver=0.1.0
pkgrel=1
pkgdesc='Distraction-free Markdown writer with a live KaTeX math preview, built with Qt Quick'
arch=('x86_64')
url='https://github.com/shakes76/omalorem'
license=('MIT')
install='omalorem.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omalorem "$pkgdir/usr/bin/omalorem"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omalorem.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omalorem.svg"
  /usr/bin/install -Dm644 "$startdir/omalorem.desktop" "$pkgdir/usr/share/applications/omalorem.desktop"
}
