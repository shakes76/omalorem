# Maintainer: shakes76 <shakes76@gmail.com>
# Forked from omawrite by David Heinemeier Hansson <david@hey.com>

pkgname=omalorem
pkgver=0.6.0
pkgrel=1
pkgdesc='Distraction-free Markdown writer with a live KaTeX math preview, built with Qt Quick'
arch=('x86_64')
url='https://github.com/shakes76/omalorem'
license=('MIT')
install='omalorem.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
# Omalorem preview: qt6-webengine and qt6-webchannel are needed only by the
# preview plugin, which the app loads the first time the preview is shown
# (docs/SPEC.md §5.3). Appended, so upstream's lines stay untouched.
depends+=('qt6-webengine' 'qt6-webchannel')
makedepends+=('qt6-webengine' 'qt6-webchannel')

# Omalorem spell check (docs/SPEC.md §4.10): hunspell itself is linked, so it
# is a hard dependency. The dictionaries are not, because the language is the
# writer's choice and the editor names the package to install when it finds
# none. en_AU is listed first for this fork's own audience.
depends+=('hunspell')
makedepends+=('hunspell')
optdepends=('hunspell-en_au: Australian English spelling dictionary'
            'hunspell-en_gb: British English spelling dictionary'
            'hunspell-en_us: American English spelling dictionary')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omalorem "$pkgdir/usr/bin/omalorem"
  # The Omalorem.Preview plugin, into /usr/lib/omalorem/qml, where the
  # binary looks beside <bindir>/../lib.
  make -C build/preview-plugin install INSTALL_ROOT="$pkgdir"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omalorem.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omalorem.svg"
  /usr/bin/install -Dm644 "$startdir/omalorem.desktop" "$pkgdir/usr/share/applications/omalorem.desktop"
}
